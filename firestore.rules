rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /pets/{petId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerId', 'authorName', 'authorPhotoUrl', 'petId', 'petName',
          'caption', 'imageUrl', 'mediaType', 'createdAt', 'likes'
        ])
        && validAuthor(request.resource.data)
        && request.resource.data.petId is string
        && request.resource.data.petName is string
        && request.resource.data.petName.size() > 0
        && request.resource.data.petName.size() <= 120
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/pets/$(request.resource.data.petId))
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 4096
        && request.resource.data.imageUrl.matches('https?://.+')
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0;

      // Cada usuario solo puede agregar o quitar su propio UID. El contador
      // se deriva de esa lista; no existe un contador editable por el cliente.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is list
        && (
          request.resource.data.likes == resource.data.likes
          || (
            !(request.auth.uid in resource.data.likes)
            && request.auth.uid in request.resource.data.likes
            && request.resource.data.likes.size() == resource.data.likes.size() + 1
            && request.resource.data.likes.hasAll(resource.data.likes)
          )
          || (
            request.auth.uid in resource.data.likes
            && !(request.auth.uid in request.resource.data.likes)
            && request.resource.data.likes.size() == resource.data.likes.size() - 1
            && resource.data.likes.hasAll(request.resource.data.likes)
          )
        );

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly([
            'userId', 'userName', 'userPhotoUrl', 'text', 'createdAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() > 0
          && request.resource.data.userName.size() <= 120
          && request.resource.data.userPhotoUrl is string
          && request.resource.data.userPhotoUrl.size() <= 4096
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(resource.data.userId);
      }
    }

    function validAuthor(data) {
      return data.ownerId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 120
        && data.authorPhotoUrl is string
        && data.authorPhotoUrl.size() <= 4096;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
