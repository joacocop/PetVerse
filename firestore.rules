rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /pets/{petId} {
        allow read, write: if isOwner(userId);
      }
      match /devices/{deviceId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 2048
          && request.resource.data.platform == 'web'
          && request.resource.data.updatedAt == request.time;
      }
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        // Solo Admin SDK desde Cloud Functions puede escribir el historial.
      }
    }

    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['name', 'photoUrl'])
        && boundedText(request.resource.data.name, 1, 120)
        && boundedText(request.resource.data.photoUrl, 0, 4096);
      allow delete: if isOwner(userId);
    }

    match /adoptions/{adoptionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && validAdoption(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(resource.data.ownerId) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active == false)
        || (validAdoption(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.petId == resource.data.petId
          && request.resource.data.createdAt == request.time));
    }

    match /chats/{chatId} {
      // Permite transacción inicial sobre un ID inexistente, no leer chats ajenos.
      allow get: if request.auth != null &&
        (!exists(/databases/$(database)/documents/chats/$(chatId))
          || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'updatedAt', 'lastText', 'lastSenderId', 'lastMessageId'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastText == ''
        && request.resource.data.lastSenderId == ''
        && request.resource.data.lastMessageId == '';
      allow update: if request.auth != null && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastText', 'lastSenderId', 'lastMessageId'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSenderId == request.auth.uid
        && boundedText(request.resource.data.lastText, 1, 2000)
        && request.resource.data.lastMessageId is string
        && !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId))
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderId == request.auth.uid
        && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text == request.resource.data.lastText;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'timestamp'])
          && request.resource.data.senderId == request.auth.uid
          && boundedText(request.resource.data.text, 1, 2000)
          && request.resource.data.timestamp == request.time
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId == messageId;
      }
    }

    function chatMember(chatId) {
      return request.auth != null && request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    function boundedText(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function validAdoption(data) {
      return data.keys().hasOnly(['ownerId','name','type','breed','age','weight',
        'photos','bio','createdAt','petId','ownerName','location','requirements','active'])
        && data.ownerId == request.auth.uid
        && data.petId is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/pets/$(data.petId))
        && boundedText(data.name, 1, 120)
        && data.type in ['dog', 'cat', 'other']
        && boundedText(data.breed, 0, 120)
        && data.age is int && data.age >= 0 && data.age <= 100
        && data.weight is number && data.weight > 0 && data.weight <= 1000
        && data.photos is list && data.photos.size() <= 10
        && boundedText(data.bio, 0, 240)
        && boundedText(data.ownerName, 1, 120)
        && boundedText(data.location, 2, 120)
        && boundedText(data.requirements, 0, 1500)
        && data.active == true;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerId', 'authorName', 'authorPhotoUrl', 'petId', 'petName',
          'caption', 'imageUrl', 'mediaType', 'createdAt', 'likes'
        ])
        && validAuthor(request.resource.data)
        && request.resource.data.petId is string
        && request.resource.data.petName is string
        && request.resource.data.petName.size() > 0
        && request.resource.data.petName.size() <= 120
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/pets/$(request.resource.data.petId))
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 4096
        && request.resource.data.imageUrl.matches('https?://.+')
        && request.resource.data.mediaType in ['image', 'video']
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0;

      // Cada usuario solo puede agregar o quitar su propio UID. El contador
      // se deriva de esa lista; no existe un contador editable por el cliente.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is list
        && (
          request.resource.data.likes == resource.data.likes
          || (
            !(request.auth.uid in resource.data.likes)
            && request.auth.uid in request.resource.data.likes
            && request.resource.data.likes.size() == resource.data.likes.size() + 1
            && request.resource.data.likes.hasAll(resource.data.likes)
          )
          || (
            request.auth.uid in resource.data.likes
            && !(request.auth.uid in request.resource.data.likes)
            && request.resource.data.likes.size() == resource.data.likes.size() - 1
            && resource.data.likes.hasAll(request.resource.data.likes)
          )
        );

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly([
            'userId', 'userName', 'userPhotoUrl', 'text', 'createdAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.userName is string
          && request.resource.data.userName.size() > 0
          && request.resource.data.userName.size() <= 120
          && request.resource.data.userPhotoUrl is string
          && request.resource.data.userPhotoUrl.size() <= 4096
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if isOwner(resource.data.userId);
      }
    }

    function validAuthor(data) {
      return data.ownerId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() > 0
        && data.authorName.size() <= 120
        && data.authorPhotoUrl is string
        && data.authorPhotoUrl.size() <= 4096;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
